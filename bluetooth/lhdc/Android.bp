cc_prebuilt_library_shared {
    name: "liblhdc",
    owner: "xiaomi",
    strip: { none: true },
    compile_multilib: "both",
    target: {
        android_arm:   { srcs: ["libs/arm/liblhdc.so"] },
        android_arm64: { srcs: ["libs/arm64/liblhdc.so"] },
    },
    apex_available: [
        "//apex_available:platform",
        "com.android.bt",
    ],
    shared_libs: [
        "liblog",
        "libc",
        "libm",
        "libstdc++",
        "libdl",
    ],
}

